                else if (h <= 0.0349441f) { hr = 0.0417274f + (h - 0.0334769f) * 8.493729553e-01f; hb = -0.0057187f + (h - 0.0334769f) * 1.933342421e+00f; }
                else if (h <= 0.0378766f) { hr = 0.0429736f + (h - 0.0349441f) * 1.005524297e+00f; hb = -0.0028821f + (h - 0.0349441f) * 1.966001705e+00f; }
